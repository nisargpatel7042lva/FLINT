rules_version = '2';

/**
 * Flint Firestore rules.
 *
 * Training data is private. Sessions are a subcollection of the owning user,
 * so ownership is a single uid comparison rather than a field check that could
 * be forged on write.
 *
 * Challenges and submissions follow group membership rules.
 *
 * Default deny: anything not matched below is refused.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMemberOfGroup(groupId) {
      return isAuthenticated() 
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isChallengeParticipant(challengeDoc) {
      return isAuthenticated() && (
        request.auth.uid == challengeDoc.creatorId ||
        request.auth.uid == challengeDoc.opponentId
      );
    }

    // Fields the client may never set — these are server-owned.
    function noServerFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['currentStreak', 'lastNudgeAt']);
    }

    // Challenge streak fields are server-owned
    function noStreakFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['currentStreak', 'bestStreak']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // Streak and nudge bookkeeping are written by Cloud Functions only
      // (the Admin SDK bypasses rules), so a client cannot inflate its streak.
      allow update: if isOwner(userId) && noServerFields();
      allow delete: if false;

      // Your friend list is yours. Names are duplicated in here rather than
      // joined from `profiles` so the list renders in one read, and because a
      // friend removing their profile should not blank your list.
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        // Document id must equal the session's day: that is what makes
        // "one session per day" structural, and streaks depend on it.
        allow create, update: if isOwner(userId)
          && request.resource.data.day == sessionId
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 600;
        allow delete: if isOwner(userId);
      }
    }

    /*
     * Public profiles.
     *
     * Readable by any signed-in user, because finding a friend by handle means
     * reading a stranger's name. Note what is NOT here: the FCM token lives on
     * `users/{uid}`, which only its owner and the Admin SDK can read. Putting
     * it on the public document would turn friend search into a way to collect
     * push tokens for every account on the platform.
     */
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.handleLower is string
        && request.resource.data.handleLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.handle == '@' + request.resource.data.handleLower
        // The handle must already be claimed BY YOU. Without this a user could
        // publish a profile carrying someone else's handle.
        && get(/databases/$(database)/documents/handles/$(request.resource.data.handleLower)).data.uid == userId;
      allow delete: if false;
    }

    /*
     * Handle claims. The document id IS the handle, so uniqueness is structural
     * rather than a check somebody has to remember to perform, and create-only
     * means a claim can never be taken from its owner.
     */
    match /handles/{handle} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    /*
     * Nudges.
     *
     * The document id encodes sender, recipient, kind and day. Combined with
     * create-only, that makes "one nudge per person per kind per day" a
     * property of the database rather than a courtesy the client extends — a
     * modified client cannot spam anybody, because the second write collides.
     *
     * `message` is accepted for the in-app list but is NOT what gets pushed;
     * the Cloud Function generates the notification text from `kind` and the
     * sender's profile name. See functions/src/pokeCopy.ts.
     */
    match /pokes/{pokeId} {
      function isParty() {
        return isSignedIn()
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid);
      }

      allow read: if isParty();

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        // You cannot nudge yourself into a streak.
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.kind in ['poke', 'challenge', 'cheer']
        && request.resource.data.day is string
        && request.resource.data.read == false
        // The id must describe its own contents, or the daily cap means nothing.
        && pokeId == request.resource.data.fromUid + '_'
                   + request.resource.data.toUid + '_'
                   + request.resource.data.kind + '_'
                   + request.resource.data.day
        // The recipient has to be a real account.
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.toUid));

      // The recipient may mark it read, and may change nothing else.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    /**
     * Groups.
     *
     * The only document in this database that several people write to, which is
     * what makes it the only one where "who is asking" has to be checked on
     * every branch rather than once at the top.
     *
     * Two kinds of group share this collection: friend groups, which people
     * create and join from the app, and the pair groups a 1:1 challenge spins
     * up when it is accepted. The second kind is written by a Cloud Function,
     * which uses the Admin SDK and is never subject to these rules — so one set
     * of rules covers both. A challenge group has no `ownerUid`, which simply
     * means the owner clauses below never match for it: nobody manages its
     * roster, and either member may still leave.
     *
     * Reads are members-only, and the client's query filters on
     * `memberIds array-contains uid` — Firestore accepts a query only when
     * every document it could return is provably allowed, so that filter is not
     * a client-side courtesy either. It is the reason the query runs at all.
     *
     * Membership changes are the interesting case. Three distinct people may
     * change `memberIds`, for three different reasons:
     *
     *   somebody joining   adds exactly their own uid, and nothing else
     *   somebody leaving   removes exactly their own uid, and nothing else
     *   the owner          adds or removes anyone
     *
     * Spelling those out separately is what stops the fourth case: a member
     * quietly removing somebody they disagree with, or adding a stranger.
     */
    match /groups/{groupId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function isOwner() {
        return isSignedIn() && request.auth.uid == resource.data.ownerUid;
      }
      function onlyMembersChanged() {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['memberIds']);
      }

      allow read: if isMember();

      // A new group starts with its creator, alone. Seeding it with other
      // people would be adding them to something they never agreed to.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.code is string
        && (!('kind' in request.resource.data)
            || request.resource.data.kind in ['club', 'squad']);

      allow update: if isSignedIn()
        && onlyMembersChanged()
        && (
          // Join: adds you and only you. Note this is allowed for a NON-member,
          // which is the whole point — you cannot read the group until you are
          // in it, so joining cannot require reading it first.
          request.resource.data.memberIds
            == resource.data.memberIds.concat([request.auth.uid])
          // Leave: removes you and only you.
          || request.resource.data.memberIds
            == resource.data.memberIds.removeAll([request.auth.uid])
          // The owner manages the roster.
          || isOwner()
        );

      // Only the owner, and only deliberately. A group emptying itself would
      // take its history with it.
      allow delete: if isOwner();

      /*
       * The club feed: runs members have posted.
       *
       * Every field is checked because this is the leaderboard's input, and a
       * leaderboard is the one place in the app people have a reason to lie.
       *
       *   - The id must start with your own uid, so you cannot post as
       *     somebody else, and the same run cannot land twice in one club.
       *   - The pace floor (2:30/km) is faster than the marathon world record.
       *     Anything quicker over half a kilometre is a bike or a car, and one
       *     drive logged as a run would sit at the top of the board all week.
       *   - The timestamp must be the server's, so a run cannot be backdated
       *     into last week's board or forward-dated to look fresh.
       *
       * Runs are never edited — a correction is a delete and a re-post — and
       * only their poster may delete them.
       */
      match /runs/{runId} {
        function inThisGroup() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        allow read: if inThisGroup();

        allow create: if inThisGroup()
          && request.resource.data.uid == request.auth.uid
          && runId.matches(request.auth.uid + '_[0-9]+')
          && request.resource.data.keys().hasOnly(
            ['uid', 'kind', 'distanceKm', 'durationSec', 'day', 'createdAt'])
          && request.resource.data.kind in ['run', 'walk']
          && request.resource.data.distanceKm is number
          && request.resource.data.distanceKm >= 0
          && request.resource.data.distanceKm <= 100
          && request.resource.data.durationSec is number
          && request.resource.data.durationSec > 0
          && request.resource.data.durationSec <= 86400
          && request.resource.data.day is string
          && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.createdAt == request.time
          && (request.resource.data.distanceKm < 0.5
              || request.resource.data.durationSec / request.resource.data.distanceKm >= 150);

        allow update: if false;
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    /**
     * Join-code reservations.
     *
     * `groupCodes/{CODE}` exists so that a code can be resolved by somebody who
     * is not yet a member — the group document itself is unreadable to them, so
     * the code could not live there and still be usable.
     *
     * Create-only, never updated: that is what makes a code unique. Two people
     * drawing the same code at the same instant do not race, because the second
     * write is refused here rather than by a check that had already read.
     *
     * `get` is allowed and `list` is not. Resolving a code requires knowing it
     * exactly; without that asymmetry the collection would be a directory of
     * every group in the app.
     */
    match /groupCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.resource.data.groupId is string;

      allow update, delete: if false;
    }

    // ── 1:1 challenges ───────────────────────────────────────────────────
    //
    // Everything below is written by Cloud Functions and is read-mostly from
    // the client. The pair group a challenge creates lives in /groups above.

    // 1:1 Challenges
    // Creation and acceptance via callables only
    match /challenges/{challengeId} {
      // Only participants can read their challenge
      // inviteToken field is creator-only (for sharing)
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.opponentId
      );
      
      // NO client create - use createOneOnOneChallenge callable
      allow create: if false;
      
      // Participants can update limited fields (e.g., marking complete)
      // But NOT core fields - those are callable-only
      allow update: if isChallengeParticipant(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['creatorId', 'opponentId', 'groupId', 'inviteToken', 'inviteTokenHash', 'acceptedAt', 'targetDays']);
      
      allow delete: if false;

      /*
       * The excuse tax: why somebody skipped a day, visible to their rival.
       *
       *   - One per person per day, and the id says so (`{uid}_{day}`), so
       *     nobody can file an excuse for their opponent or stack several.
       *   - Create-only. The whole tax is that "couldn't be bothered" stays
       *     said; an excuse that could be edited into "planned rest day" after
       *     the rival has read it would cost nothing.
       *   - Only the two people in the challenge can read or write them.
       */
      match /excuses/{excuseId} {
        function inThisChallenge() {
          return isChallengeParticipant(
            get(/databases/$(database)/documents/challenges/$(challengeId)).data
          );
        }

        allow read: if inThisChallenge();

        allow create: if inThisChallenge()
          && request.resource.data.keys().hasOnly(['uid', 'day', 'reason', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.day is string
          && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && excuseId == request.auth.uid + '_' + request.resource.data.day
          && request.resource.data.reason in ['rest', 'injured', 'busy', 'weather', 'motivation']
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Challenge submissions (activity logs)
    // ONLY Cloud Functions can create submissions (via Admin SDK)
    match /submissions/{submissionId} {
      // Anyone can read submissions in groups they're part of
      allow read: if isAuthenticated() && (
        isMemberOfGroup(resource.data.groupId) ||
        request.auth.uid == resource.data.memberId
      );
      
      // Client CANNOT create submissions - only logChallengeActivity callable can
      allow create: if false;
      
      // Users can update their own submissions (reactions, notes)
      // But NOT core fields like day, effort, status
      allow update: if isAuthenticated()
        && resource.data.memberId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['memberId', 'groupId', 'day', 'kind', 'effort', 'status', 'createdAt']);
      
      allow delete: if false;
    }

    /*
     * Challenge streaks, computed by Cloud Functions.
     *
     * Readable by the two people in the challenge, and nobody else. It was
     * readable by ANY signed-in account, which made every user's training
     * consistency public to anyone who could guess a document id — and the ids
     * are `{challengeId}_{uid}`, so they are not hard to guess at all.
     *
     * Both participants need it, not just the owner: showing your opponent's
     * streak next to yours is the entire point of a 1:1 challenge, so this
     * resolves the challenge rather than comparing the uid in the key.
     */
    match /challengeStreaks/{streakId} {
      allow read: if isAuthenticated()
        && isChallengeParticipant(
          get(/databases/$(database)/documents/challenges/$(resource.data.challengeId)).data
        );
      // Only Cloud Functions can write streaks.
      allow write: if false;
    }

    /*
     * Abuse counters, written only by Cloud Functions through the Admin SDK.
     *
     * Explicitly unreadable: knowing how many guesses you have left is itself
     * useful to somebody working through a token space.
     */
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
