<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon: the SPARK, not the stones.

  Android renders notification small icons as a pure alpha mask — every opaque
  pixel becomes white. That rules out the full mark, which would flatten into
  an unreadable square, and it also rules out the stone silhouette: two angular
  shards forming a V is the part of this mark that most resembles other logos,
  and it is the part with no meaning of its own. The spark is what says Flint.

  It also survives the mask better. A burst of rays reads at 24dp; a filled
  chevron reads as a filled chevron.

  Scaled up because the spark occupies a small part of the source's 1024
  canvas — correct in the full mark, far too small alone in a status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group android:scaleX="3" android:scaleY="3"
        android:translateX="-1128.25" android:translateY="-712">
